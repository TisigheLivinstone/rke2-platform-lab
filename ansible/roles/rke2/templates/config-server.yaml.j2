# Managed by Ansible (roles/rke2)
token: {{ rke2_token }}
node-ip: {{ ansible_host }}
advertise-address: {{ ansible_host }}
tls-san:
  - {{ ansible_host }}
  - {{ inventory_hostname }}
write-kubeconfig-mode: "0600"

# CIS Kubernetes Benchmark hardening: Pod Security "restricted" by default,
# audit logging, and protected kernel settings.
profile: cis

# Pod networking. RKE2 ships Cilium; Part 4 configures it further.
cni: cilium

# Nothing is published to the internet yet, so no ingress controller.
disable:
  - rke2-traefik

# RKE2's default CPU reservations for the control plane add up to 1100m, more
# than this 1 vCPU node has, which leaves no room for the Cilium install job.
# These are reservations for scheduling, not limits: each component can still
# use the whole vCPU when it's free. On a 2 vCPU control plane, keep the defaults.
control-plane-resource-requests: >-
  kube-apiserver-cpu=150m,etcd-cpu=100m,kube-controller-manager-cpu=100m,kube-scheduler-cpu=50m,kube-proxy-cpu=50m,cloud-controller-manager-cpu=50m

# Keep application pods off the control plane. System add-ons tolerate this.
node-taint:
  - "CriticalAddonsOnly=true:NoExecute"

# etcd snapshots on the node every 6 hours. Part 7 copies them off the VM.
etcd-snapshot-schedule-cron: "0 */6 * * *"
etcd-snapshot-retention: 10
