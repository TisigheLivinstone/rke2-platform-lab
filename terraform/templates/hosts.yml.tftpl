# Written by Terraform from the real VM IPs. Changes here are overwritten on the next apply.
all:
  vars:
    ansible_user: ${admin_username}
    ansible_ssh_private_key_file: ${private_key}
  children:
    bastion:
      hosts:
        ${bastion_name}:
          ansible_host: ${bastion_ip}
          ansible_ssh_common_args: "-o IdentitiesOnly=yes -o UserKnownHostsFile=${known_hosts} -o StrictHostKeyChecking=accept-new"
    # Every VM in the private subnet. Ansible reaches them through the bastion.
    cluster:
      vars:
        ansible_ssh_common_args: "-o IdentitiesOnly=yes -o UserKnownHostsFile=${known_hosts} -o StrictHostKeyChecking=accept-new -o ProxyCommand=\"ssh -i ${private_key} -o IdentitiesOnly=yes -o UserKnownHostsFile=${known_hosts} -o StrictHostKeyChecking=accept-new -W %h:%p ${admin_username}@${bastion_ip}\""
      children:
        control_plane:
          hosts:
            ${control_plane}:
              ansible_host: ${control_plane_ip}
        workers:
          hosts:
%{ for name, ip in workers ~}
            ${name}:
              ansible_host: ${ip}
%{ endfor ~}
    # VMs that carry an empty data disk at LUN 0 for cluster storage.
    storage_nodes:
      hosts:
%{ for name in storage_nodes ~}
        ${name}:
%{ endfor ~}
