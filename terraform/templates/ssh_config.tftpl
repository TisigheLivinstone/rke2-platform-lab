# Generated by Terraform. Use with: ssh -F ssh_config <host>

Host bastion
  HostName ${bastion_ip}
  User ${admin_username}
  StrictHostKeyChecking accept-new

Host ${control_plane}
  HostName ${control_plane_ip}
  User ${admin_username}
  ProxyJump bastion

%{ for name, ip in workers ~}
Host ${name}
  HostName ${ip}
  User ${admin_username}
  ProxyJump bastion

%{ endfor ~}
